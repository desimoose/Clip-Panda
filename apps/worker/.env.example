# Postgres connection string (same value as apps/web/.env.local and packages/db/.env.example)
DATABASE_URL=
# Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# S3-compatible object storage (e.g. Cloudflare R2 free tier or AWS S3).
# For real AWS S3, omit S3_ENDPOINT.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
