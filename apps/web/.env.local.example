# Google OAuth Client (Google Cloud Console -> APIs & Services -> Credentials -> OAuth Client ID, type "Web application",
# authorized redirect URI http://localhost:3000/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: npx auth secret
AUTH_SECRET=
# Postgres connection string (same value as packages/db/.env.example DATABASE_URL)
DATABASE_URL=
# Google AI Studio API key (read by @clip-panda/gemini from the highlight/clip-candidate API routes)
GEMINI_API_KEY=
# S3-compatible object storage (read by @clip-panda/storage from the import/export routes).
# For real AWS S3, omit S3_ENDPOINT.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
